# Django Configuration
SECRET_KEY=django-insecure-cuj6ga!fb+q=f&eb%#ba)(0*a()13+ck1z$t=pzepa!yfc1fb^
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# If DB_ENGINE is set to 'postgresql', it will use the PostgreSQL credentials below.
# Set to 'sqlite' if you want to fall back to local sqlite.
DB_ENGINE=postgresql
DB_NAME=cu_library_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Brevo (Sendinblue) Email Service Configuration
# Get your API key and SMTP key from https://app.brevo.com/settings/keys/api and https://app.brevo.com/settings/keys/smtp
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_LOGIN=your_brevo_smtp_login_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
DEFAULT_FROM_EMAIL=CU Library <no-reply@culibrary.org>

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000
